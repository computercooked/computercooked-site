{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8787/",
        "http://127.0.0.1:8787/games/",
        "http://127.0.0.1:8787/games/one-percent-popup/",
        "http://127.0.0.1:8787/games/reel-weird/"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
