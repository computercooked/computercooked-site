{
  // Static site + a small API Worker. Files are served from the repo root by the assets binding;
  // only /api/* runs src/worker.js. Deploys on merge to main via Workers Builds (`npx wrangler deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "computercooked-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Tip jar: empty = off. Set to the public Stripe Payment Link (https://buy.stripe.com/…) and merge to switch
  // the "tip the computer" link on (hub footer + after a run). Anything that isn't a buy.stripe.com link stays off.
  "vars": { "TIP_URL": "https://buy.stripe.com/7sYeVd2Dz9Tsc7leM5fYY00" },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/u/*", "/games/*"]
  },
  // the schema file is bundled into the Worker so it can create tables on first use
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // D1 is added once the database exists (scripts/setup-cloudflare.ps1 fills in the id).
  // Until then the API answers "database not configured" and the site hides accounts,
  // leaderboards and feedback instead of erroring.
  "d1_databases": [{ "binding": "DB", "database_name": "computercooked", "database_id": "5d407ec0-06ff-49dc-952c-2a3c77905ab0", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
  // Secret (not in this file): ADMIN_TOKEN, set with `npx wrangler secret put ADMIN_TOKEN`.
}
